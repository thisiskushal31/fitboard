# Optional. Fitboard still crawls public boards with none of these set.
# Consumer chat plans (Claude.ai, ChatGPT Plus, Cursor IDE) are not API keys.
# Use one provider. LLM_PROVIDER can force cursor|anthropic|openai|gemini.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Cursor Cloud Agents keys are not chat completions. Only set CURSOR_BASE_URL
# if you have an OpenAI-compatible gateway in front of Cursor.
CURSOR_API_KEY=
# CURSOR_BASE_URL=
# CURSOR_MODEL=composer-2.5

# LLM_PROVIDER=anthropic

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
